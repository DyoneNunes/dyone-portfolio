# Copie para .env e preencha com credenciais reais (NUNCA commitar o .env)
# App Password do Gmail: https://myaccount.google.com/apppasswords
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
# 3002 porque a 3001 já é usada pelo nirmind-api nesta máquina
PORT=3002

# --- Postgres (leads do formulário) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portfolio_leads
# Em Docker o hostname é o nome do serviço ("postgres");
# rodando local fora do Docker, troque para localhost:5440
DATABASE_URL=postgresql://portfolio:troque_esta_senha@postgres:5432/portfolio_leads

# --- Redis (rate-limit persistente) ---
REDIS_URL=redis://redis:6379

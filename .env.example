# Copie para .env e preencha com credenciais reais (NUNCA commitar o .env)
# --- Email (SMTP da caixa do domínio) ---
# Só a senha é obrigatória; os demais já são o padrão do código.
SMTP_PASS=troque_pela_senha_da_caixa
SMTP_HOST=mail.nirmind.com.br
SMTP_PORT=465
SMTP_USER=contato@dyonedev.com.br
# Remetente dos emails e caixa que recebe os leads (padrão: SMTP_USER)
EMAIL_REMETENTE=contato@dyonedev.com.br
EMAIL_DESTINO=contato@dyonedev.com.br
# 3002 porque a 3001 já é usada pelo nirmind-api nesta máquina
PORT=3002

# --- Postgres (leads do formulário) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portfolio_leads
# Em Docker o hostname é o nome do serviço ("postgres");
# rodando local fora do Docker, troque para localhost:5440
DATABASE_URL=postgresql://portfolio:troque_esta_senha@postgres:5432/portfolio_leads

# --- Redis (rate-limit persistente) ---
REDIS_URL=redis://redis:6379
